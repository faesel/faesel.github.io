# Contentful Configuration
# Get these from your Contentful account: https://app.contentful.com
CONTENTFUL_SPACE_ID=your_space_id_here
CONTENTFUL_ACCESS_TOKEN=your_delivery_api_token_here
CONTENTFUL_MANAGEMENT_TOKEN=your_management_token_optional

# Google Analytics (optional)
# Get your Measurement ID from Google Analytics: https://analytics.google.com
NEXT_PUBLIC_GOOGLE_TRACKING_ID=G-XXXXXXXXXX

# GitHub activity (optional, server-side only)
# Public-data access is sufficient. GitHub Actions uses its built-in GITHUB_TOKEN.
# Never use a NEXT_PUBLIC_ prefix for this token.
GITHUB_STATS_TOKEN=
